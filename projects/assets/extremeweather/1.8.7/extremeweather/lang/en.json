{
  "block-icicle-*": "Icicles",
  "block-snowedclutter-*": "Snow-covered clutter",
  "snowedclutter-name": "Snowed {0}",
  "game:worldconfig-category-extremeweather": "ExtremeWeather",
  "game:worldattribute-exwBlockDestruction": "Storms destroy blocks",
  "game:worldattribute-exwBlockDestruction-desc": "Allows extreme wind to break things: shattered windows, ripped-out doors, torn thatch roofing, shredded tree canopies, snow-crushed plank roofs. Off = your builds are safe.",
  "game:worldattribute-exwDeepSnow": "Deep snow accumulation",
  "game:worldattribute-exwDeepSnow-desc": "Snow piles up far beyond vanilla depth during snowfall: layered drifts, buried foliage, whitened roofs, snow that flows downhill. The heart of the mod's winters.",
  "game:worldattribute-exwMaxSnowDepth": "Maximum snow depth",
  "game:worldattribute-exwMaxSnowDepth-desc": "How many full blocks of snow can stack up beyond the vanilla surface layer.",
  "game:worldattribute-exwMaxSnowDepth-unit": "{0} blocks",
  "game:worldattribute-exwSnowFlow": "Snow flows downhill",
  "game:worldattribute-exwSnowOnLeaves": "Snow on tree canopies",
  "game:worldattribute-exwSnowCatchUp": "Snow catch-up on chunk load",
  "game:worldattribute-exwCropDamage": "Weather damages crops",
  "game:worldattribute-exwCropDamage-desc": "Allows weather to kill crops — hurricane winds, sandstorm scouring, heat wave drought — leaving withered husks standing in the field. Off = farms are safe.",
  "game:worldattribute-exwWeatherEvents": "Natural weather events",
  "game:worldattribute-exwWeatherEvents-desc": "Master switch: blizzards, monsoons, hurricanes, heat waves and cold snaps roll naturally with the seasons. Events strike without warning — watch the skies. Off = only ambient weather effects remain.",
  "game:worldattribute-exwBlizzardEventChance": "Blizzard chance (winter)",
  "game:worldattribute-exwBlizzardEventChance-desc": "Chance each qualifying winter day (below -5°C) that a blizzard strikes: hours of heavy snowfall with wind rolled anywhere from stiff to destructive.",
  "game:worldattribute-exwBlizzardEventChance-unit": "{0}%",
  "game:worldattribute-exwMonsoonEventChance": "Monsoon chance (summer)",
  "game:worldattribute-exwMonsoonEventChance-desc": "Chance each qualifying summer day (above 20°C) that a monsoon strikes: hours of torrential, wind-driven rain.",
  "game:worldattribute-exwMonsoonEventChance-unit": "{0}%",
  "game:worldattribute-exwHurricaneFrequency": "Hurricane chance (never in winter)",
  "game:worldattribute-exwHurricaneFrequency-desc": "Chance each day, outside winter and above 10°C, that a hurricane strikes: winds strong enough to destroy anything exposed — and to spawn tornadoes.",
  "game:worldconfig-exwHurricaneFrequency-Off": "Off",
  "game:worldconfig-exwHurricaneFrequency-Half": "0.5% (default)",
  "game:worldconfig-exwHurricaneFrequency-One": "1%",
  "game:worldconfig-exwHurricaneFrequency-Two": "2%",
  "game:worldconfig-exwHurricaneFrequency-Five": "5%",
  "game:worldconfig-exwHurricaneFrequency-Ten": "10%",
  "game:worldattribute-exwHeatwaveEventChance": "Heat wave chance (peaks in summer)",
  "game:worldattribute-exwHeatwaveEventChance-desc": "Chance per day once the local temperature has stayed above 33°C for a full day: a heat wave spikes it a further 10-25°C for up to two days, baking farmland dry.",
  "game:worldattribute-exwHeatwaveEventChance-unit": "{0}%",
  "game:worldattribute-exwColdsnapEventChance": "Cold snap chance (peaks in winter)",
  "game:worldattribute-exwColdsnapEventChance-desc": "Chance each below-freezing day that a cold snap drops the temperature 10-25°C for up to two days. Likeliest in winter, rare off-season.",
  "game:worldattribute-exwEventGraceDays": "Calm days between events",
  "game:worldattribute-exwEventGraceDays-desc": "After a weather event ends, no new event can begin for this many game days. The skies always rest between disasters.",
  "game:worldconfig-exwEventGraceDays-Off": "Off",
  "game:worldconfig-exwEventGraceDays-1": "1 day",
  "game:worldconfig-exwEventGraceDays-2": "2 days",
  "game:worldconfig-exwEventGraceDays-3": "3 days",
  "game:worldconfig-exwEventGraceDays-5": "5 days",
  "game:worldconfig-exwEventGraceDays-7": "7 days (default)",
  "game:worldconfig-exwEventGraceDays-10": "10 days",
  "game:worldconfig-exwEventGraceDays-14": "14 days",
  "game:worldattribute-exwColdsnapEventChance-unit": "{0}%",
  "game:worldattribute-exwModSounds": "Storm sounds",
  "game:worldattribute-exwModSounds-desc": "All sounds this mod brings: storm and blizzard loops, howling wind, house creaks, rattling doors and windows, indoor rain, breaking and falling. Off = the mod is completely silent.",
  "game:worldattribute-exwModVolume": "Storm sound volume",
  "game:worldattribute-exwModVolume-desc": "World-wide volume of all this mod's sounds. Each player's own ambience setting applies on top.",
  "game:worldattribute-exwModVolume-unit": "{0}%",
  "game:worldattribute-exwMovementSlowdown": "Storms slow movement",
  "game:worldattribute-exwMovementSlowdown-desc": "Pushing into a storm headwind or wading through deep snow slows you down; a tailwind carries you along.",
  "game:worldattribute-exwWindItems": "Wind blows dropped items",
  "game:worldattribute-exwWindItems-desc": "Dropped items get blown downwind in the open during storms. Placed blocks are never moved.",
  "game:worldattribute-exwWindShoveStrength": "Wind force on players",
  "game:worldattribute-exwWindShoveStrength-desc": "How hard storm winds physically push players, animals and dropped items. Sheltering behind walls blocks it; sneaking braces against it. Off = no push.",
  "game:worldattribute-exwPlankAging": "Rain ages planks",
  "game:worldattribute-exwPlankAging-desc": "Rain-exposed plank blocks slowly weather into aged planks and eventually rot through. Keep them roofed.",
  "game:worldattribute-exwAnimalStormEffects": "Storms affect animals",
  "game:worldattribute-exwAnimalStormEffects-desc": "Land animals are shoved around by storm winds just like players. Fish and other water dwellers are always safe.",
  "game:worldattribute-exwCanopySnowBlow": "Wind strips canopy snow",
  "game:worldattribute-exwAvalanches": "Avalanches",
  "game:worldattribute-exwStormSounds": "Storm sounds and rattles",
  "game:worldattribute-exwBlockDestructionWindThreshold": "Block destruction wind threshold",
  "game:worldattribute-exwBlockDestructionWindThreshold-unit": "{0}%",
